# =========================================================
# SDT — Encabezados de seguridad para hosting con Apache
# (la mayoría de los hostings chilenos con cPanel usan Apache)
# =========================================================

<IfModule mod_headers.c>
    # Impide que otro sitio muestre esta página dentro de un marco (evita engaños tipo "clickjacking")
    Header always set X-Frame-Options "DENY"
    # El navegador no adivina tipos de archivo (evita ejecutar archivos disfrazados)
    Header always set X-Content-Type-Options "nosniff"
    # No comparte la dirección completa de la página con sitios externos
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # Bloquea el acceso a cámara, micrófono, ubicación y pagos
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    # Obliga a usar HTTPS (activar solo cuando el sitio ya tenga certificado SSL)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Política de contenido (la misma del index.html, más la protección contra marcos)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src https://formsubmit.co; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
</IfModule>

# Redirige todo el tráfico a HTTPS
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# No muestra la lista de archivos de las carpetas
Options -Indexes

# Bloquea el acceso a archivos ocultos y de documentación
<FilesMatch "^(\.|LEEME\.md$)">
    Require all denied
</FilesMatch>
